    {
      "name": "04 - PUT Reserva (actualizar)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"PUT reserva devuelve 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"La reserva quedó actualizada\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.id).to.eql(Number(pm.environment.get(\"reservaId\")));\r\n    pm.expect(json.fecha).to.eql(\"2026-10-25\");\r\n    pm.expect(json.horaInicio).to.eql(\"10:00\");\r\n    pm.expect(json.horaFin).to.eql(\"12:00\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"fecha\": \"2026-10-25\",\r\n  \"horaInicio\": \"10:00\",\r\n  \"horaFin\": \"12:00\"\r\n}",
