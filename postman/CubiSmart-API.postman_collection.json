    {
      "name": "03 - POST Reserva (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"POST reserva devuelve 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"La reserva creada tiene id y los datos enviados\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json).to.have.property(\"id\");\r\n    pm.expect(json.cubiculoId).to.eql(2);\r\n    pm.expect(json.fecha).to.eql(\"2026-10-20\");\r\n    pm.environment.set(\"reservaId\", json.id);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"cubiculoId\": 2,\r\n  \"usuario\": \"estudiante\",\r\n  \"fecha\": \"2026-10-20\",\r\n  \"horaInicio\": \"14:00\",\r\n  \"horaFin\": \"16:00\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/reservas",
          "host": [
